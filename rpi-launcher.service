[Unit]
Description=Raspberry Pi TUI Launcher
After=network.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mini_mac
ExecStart=/home/pi/mini_mac/venv/bin/python main.py
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
